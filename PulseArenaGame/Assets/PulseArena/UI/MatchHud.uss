/* Pulse Arena match HUD (T10, D13). Original styling: flat colours, borders and rounded corners only.
   UI Toolkit has no box-shadow and no gradients, so a button's 3D look is a darker lower border that shrinks when the button
   is pressed (:active). This sheet has no transitions, so Reduce Motion has nothing to switch off (D6). */

.hud-root {
    flex-direction: column;
    padding: 16px;
}

.hud-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 16, 24, 0.86);
    border-radius: 28px;
    padding: 12px 16px;
}

.hud-badge {
    align-items: center;
    background-color: #F6C945;
    border-radius: 18px;
    padding: 6px 18px;
    margin-right: 14px;
}

.hud-badge-label {
    font-size: 18px;
    color: #3A2E08;
    -unity-font-style: bold;
}

.hud-badge-value {
    font-size: 40px;
    color: #1B1500;
    -unity-font-style: bold;
}

.hud-score {
    flex-grow: 1;
    align-items: flex-start;
}

.hud-kicker {
    font-size: 20px;
    color: #8FA3B5;
}

.hud-value {
    font-size: 40px;
    color: #F4F7FA;
    -unity-font-style: bold;
}

.hud-pill {
    background-color: #2A3B4C;
    color: #F4F7FA;
    font-size: 26px;
    border-radius: 22px;
    border-bottom-width: 5px;
    border-bottom-color: #121C26;
    padding: 12px 22px;
}

.hud-pill:active {
    margin-top: 5px;
    border-bottom-width: 0px;
}

.hud-panel {
    margin-top: 12px;
    background-color: rgba(10, 16, 24, 0.7);
    border-radius: 22px;
    padding: 12px 18px;
}

.hud-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-row-gap {
    margin-top: 10px;
}

.hud-kicker-value {
    font-size: 22px;
    color: #F4F7FA;
    -unity-font-style: bold;
}

.hud-track {
    height: 16px;
    margin-top: 8px;
    background-color: #1C2A36;
    border-radius: 8px;
    overflow: hidden;
}

.hud-track-small {
    height: 10px;
}

.hud-fill {
    height: 100%;
    background-color: #3FC1BA;
    border-radius: 8px;
}

.hud-fill-combo {
    background-color: #F6C945;
}

.hud-card {
    align-items: center;
    background-color: rgba(10, 16, 24, 0.92);
    border-radius: 32px;
    padding: 28px 24px;
}

.hud-banner {
    font-size: 48px;
    color: #F4F7FA;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 22px;
    padding: 12px 28px;
    margin-bottom: 8px;
}

.hud-banner-won {
    background-color: #2FA89F;
}

.hud-banner-lost {
    background-color: #E0604A;
}

.hud-detail {
    font-size: 26px;
    color: #C9D6E2;
    margin-bottom: 18px;
}

.hud-buttons {
    flex-direction: row;
    justify-content: center;
}

.hud-button {
    font-size: 34px;
    -unity-font-style: bold;
    border-radius: 22px;
    border-bottom-width: 8px;
    padding: 16px 34px;
    margin: 8px;
}

.hud-button-primary {
    background-color: #3FC1BA;
    border-bottom-color: #1F8F89;
    color: #0C1116;
}

.hud-button-secondary {
    background-color: #2A3B4C;
    border-bottom-color: #121C26;
    color: #F4F7FA;
}

.hud-button:active {
    margin-top: 13px;
    border-bottom-width: 3px;
}

.hud-tray {
    align-items: center;
    background-color: rgba(10, 16, 24, 0.86);
    border-radius: 26px;
    padding: 14px 18px;
}

.hud-pips {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
}

.hud-pip {
    width: 40px;
    height: 40px;
    margin: 0px 4px;
    border-radius: 12px;
    background-color: #1C2A36;
    border-bottom-width: 5px;
    border-bottom-color: #0B1218;
}

.hud-pip-on {
    background-color: #3FC1BA;
    border-bottom-color: #1F8F89;
}

/* Declared after .hud-pip-on, so a warm tray (six or seven tiles) overrides the teal. */
.hud-pip-warn {
    background-color: #E0604A;
    border-bottom-color: #9E3F2F;
}

/* Landscape (set by MatchHud on the root): the same blocks in less height, so the board keeps the middle band. */
.hud-landscape .hud-root {
    padding: 10px;
}

.hud-landscape .hud-bar {
    padding: 6px 14px;
    border-radius: 22px;
}

.hud-landscape .hud-badge {
    padding: 2px 14px;
    margin-right: 10px;
}

.hud-landscape .hud-badge-label {
    font-size: 15px;
}

.hud-landscape .hud-badge-value {
    font-size: 30px;
}

.hud-landscape .hud-kicker {
    font-size: 16px;
}

.hud-landscape .hud-value {
    font-size: 30px;
}

.hud-landscape .hud-pill {
    font-size: 20px;
    padding: 8px 16px;
    border-radius: 16px;
}

.hud-landscape .hud-panel {
    margin-top: 6px;
    padding: 6px 14px;
    border-radius: 16px;
}

.hud-landscape .hud-row-gap {
    margin-top: 2px;
}

.hud-landscape .hud-kicker-value {
    font-size: 18px;
}

.hud-landscape .hud-track {
    height: 10px;
    margin-top: 4px;
}

.hud-landscape .hud-track-small {
    height: 7px;
}

.hud-landscape .hud-tray {
    padding: 6px 14px;
    border-radius: 18px;
}

.hud-landscape .hud-pips {
    margin-top: 4px;
}

.hud-landscape .hud-pip {
    width: 24px;
    height: 24px;
    margin: 0px 3px;
    border-radius: 8px;
}
